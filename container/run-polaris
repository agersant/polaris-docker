#! /bin/sh

POLARIS_ARGS="-p ${POLARIS_PORT:-5050}"
[ -n "${POLARIS_CONFIG_FILE}" ] && POLARIS_ARGS="${POLARIS_ARGS} -c ${POLARIS_CONFIG_FILE}"
[ -n "${POLARIS_DATA_DIR}" ] && POLARIS_ARGS="${POLARIS_ARGS} -d ${POLARIS_DATA_DIR}"
[ -n "${POLARIS_CACHE_DIR}" ] && POLARIS_ARGS="${POLARIS_ARGS} --cache ${POLARIS_CACHE_DIR}"
[ -n "${POLARIS_LOG_LEVEL}" ] && POLARIS_ARGS="${POLARIS_ARGS} --log-level ${POLARIS_LOG_LEVEL}"

polaris ${POLARIS_ARGS}
